PORT=5000
NODE_ENV=development
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
MONGODB_URI=mongodb://admin:password@localhost:27017/enterprise_knowledge_copilot?authSource=admin
UPLOAD_DIR=./uploads
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
EMBEDDING_PROVIDER=openai
# Default models: OpenAI text-embedding-3-small (1536 dimensions),
# Gemini gemini-embedding-2 (3072 dimensions).
# Override only when you intend to use a different model and dimension.
EMBEDDING_MODEL=text-embedding-3-small
# Gemini text generation uses a separate model from embeddings.
GEMINI_GENERATION_MODEL=gemini-3.5-flash
# Set only the key for the selected provider:
# OPENAI_API_KEY=<your-openai-key>
# GEMINI_API_KEY=<your-gemini-key>
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
